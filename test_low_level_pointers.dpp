@include "io"
@include "memory"

// Test 1: Address-Of and Dereference Mutate Original Variable
int value = 100
int* ptr = &value
*ptr = 250
io.readline.print("Test 1: ", value)

// Test 2: Pointer Arithmetic
int val2 = 20
int* pArr = &val2
io.readline.print("Test 2: ", *pArr)

// Test 3: Struct Pointer Member Access (->)
struct Player:
    int health = 0
end

Player p = Player()
Player* pPlayer = &p
pPlayer->health = 100
io.readline.print("Test 3: ", p.health)

// Test 4: Typed Memory Allocation
int* buf = memory.alloc(5)
*buf = 300
io.readline.print("Test 4: ", *buf)
memory.free(buf)

// Test 5: Integer Address Conversion (uintptr)
int rawVal = 123
uintptr address = (uintptr)&rawVal
int* pRaw = (int*)address
io.readline.print("Test 5: ", *pRaw)
